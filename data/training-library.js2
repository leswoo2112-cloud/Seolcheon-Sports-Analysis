/* =========================================================
   23. SEARCH FUNCTIONS
========================================================= */

function getTrainingLibrary() {

  return [
    ...SEOLCHEON_TRAINING_LIBRARY
  ];

}


function getTrainingById(
  id
) {

  return (
    SEOLCHEON_TRAINING_LIBRARY
      .find(
        item =>
          item.id === id
      ) ||
    null
  );

}


function getTrainingByCategory(
  category
) {

  return SEOLCHEON_TRAINING_LIBRARY
    .filter(
      item =>
        item.category ===
        category
    );

}


function getTrainingByTarget(
  target
) {

  return SEOLCHEON_TRAINING_LIBRARY
    .filter(
      item =>
        Array.isArray(
          item.targets
        ) &&
        item.targets.includes(
          target
        )
    );

}


function getTrainingBySport(
  sport
) {

  return SEOLCHEON_TRAINING_LIBRARY
    .filter(
      item =>
        Array.isArray(
          item.sport
        ) &&
        item.sport.includes(
          sport
        )
    );

}


function searchTraining(
  keyword
) {

  const query =
    String(
      keyword || ""
    )
    .trim()
    .toLowerCase();


  if (!query) {

    return getTrainingLibrary();

  }


  return SEOLCHEON_TRAINING_LIBRARY
    .filter(
      item => {

        const text = [
          item.id,
          item.name,
          item.category,
          item.area,
          ...(item.tags || []),
          ...(item.targets || []),
          ...(item.sport || [])
        ]
        .join(" ")
        .toLowerCase();


        return text.includes(
          query
        );

      }
    );

}


/* =========================================================
   24. MULTIPLE TARGET SEARCH
========================================================= */

function getTrainingForWeaknesses(
  weaknesses = [],
  limit = 12
) {

  const targets =
    weaknesses
      .map(
        weakness =>
          typeof weakness === "string"
            ? weakness
            : weakness.key
      )
      .filter(Boolean);


  const scored =
    SEOLCHEON_TRAINING_LIBRARY
      .map(
        item => {

          let score = 0;


          targets.forEach(
            target => {

              if (
                item.targets &&
                item.targets.includes(
                  target
                )
              ) {

                score += 10;

              }

            }
          );


          return {
            ...item,
            recommendationScore:
              score
          };

        }
      )

      .filter(
        item =>
          item.recommendationScore >
          0
      )

      .sort(
        (a, b) =>
          b.recommendationScore -
          a.recommendationScore
      );


  return scored.slice(
    0,
    limit
  );

}


/* =========================================================
   25. SPORT + WEAKNESS RECOMMENDATION
========================================================= */

function getSmartTrainingRecommendation({
  sport = "",
  weaknesses = [],
  limit = 12
} = {}) {

  const targets =
    weaknesses
      .map(
        weakness =>
          typeof weakness === "string"
            ? weakness
            : weakness.key
      )
      .filter(Boolean);


  const scored =
    SEOLCHEON_TRAINING_LIBRARY
      .map(
        item => {

          let score = 0;


          /* 약점 일치 */

          targets.forEach(
            target => {

              if (
                item.targets &&
                item.targets.includes(
                  target
                )
              ) {

                score += 20;

              }

            }
          );


          /* 종목 일치 */

          if (
            sport &&
            Array.isArray(
              item.sport
            ) &&
            item.sport.includes(
              sport
            )
          ) {

            score += 30;

          }


          /* 공통 훈련 */

          if (
            !item.sport
          ) {

            score += 5;

          }


          return {
            ...item,
            recommendationScore:
              score
          };

        }
      )

      .filter(
        item =>
          item.recommendationScore >
          0
      )

      .sort(
        (a, b) =>
          b.recommendationScore -
          a.recommendationScore
      );


  /* 중복 이름 제거 */

  const used =
    new Set();


  return scored
    .filter(
      item => {

        if (
          used.has(
            item.name
          )
        ) {

          return false;

        }


        used.add(
          item.name
        );

        return true;

      }
    )
    .slice(
      0,
      limit
    );

}


/* =========================================================
   26. RANDOM TRAINING
========================================================= */

function getRandomTraining(
  count = 6
) {

  const copy = [
    ...SEOLCHEON_TRAINING_LIBRARY
  ];


  for (
    let i =
      copy.length - 1;

    i > 0;

    i--
  ) {

    const j =
      Math.floor(
        Math.random() *
        (i + 1)
      );


    [
      copy[i],
      copy[j]
    ] = [
      copy[j],
      copy[i]
    ];

  }


  return copy.slice(
    0,
    count
  );

}


/* =========================================================
   27. TRAINING STATISTICS
========================================================= */

function getTrainingLibraryStats() {

  const categories =
    {};

  const sports =
    {};


  SEOLCHEON_TRAINING_LIBRARY
    .forEach(
      item => {

        categories[
          item.category
        ] =
          (
            categories[
              item.category
            ] ||
            0
          ) + 1;


        if (
          Array.isArray(
            item.sport
          )
        ) {

          item.sport.forEach(
            sport => {

              sports[
                sport
              ] =
                (
                  sports[
                    sport
                  ] ||
                  0
                ) + 1;

            }
          );

        }

      }
    );


  return {

    total:
      SEOLCHEON_TRAINING_LIBRARY
        .length,

    categories,

    sports

  };

}


/* =========================================================
   28. PUBLIC API
========================================================= */

window.SeolcheonTrainingLibrary = {

  data:
    SEOLCHEON_TRAINING_LIBRARY,

  all:
    getTrainingLibrary,

  byId:
    getTrainingById,

  byCategory:
    getTrainingByCategory,

  byTarget:
    getTrainingByTarget,

  bySport:
    getTrainingBySport,

  search:
    searchTraining,

  forWeaknesses:
    getTrainingForWeaknesses,

  recommend:
    getSmartTrainingRecommendation,

  random:
    getRandomTraining,

  stats:
    getTrainingLibraryStats

};


